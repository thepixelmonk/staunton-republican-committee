---
// Heartland Gothic. global.css FIRST — it carries @import "tailwindcss",
// which establishes the @layer order every theme partial relies on.
import '../styles/global.css';
import '@fontsource-variable/big-shoulders';
import '@fontsource-variable/hanken-grotesk';
import '../styles/themes/gothic/system.css';
import '../styles/themes/gothic/hero.css';
import '../styles/themes/gothic/modules.css';
import '../styles/themes/gothic/engagement.css';

import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
type Props = Omit<BaseProps, 'theme'>;
---

<BaseLayout theme="gothic" {...Astro.props}><slot /></BaseLayout>
