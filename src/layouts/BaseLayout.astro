---
// The document shell for Letterpress Civic — the site's one design.
//
// Fonts and stylesheets are imported here. global.css must come FIRST: it
// carries `@import "tailwindcss"`, and the four theme partials are unlayered,
// which is what lets them beat Tailwind's utilities.
//
// Zilla Slab is NOT a variable family, so each weight is a separate file.
// Import only the latin subsets and only the three weights the design sets
// (500 / 600 / 700) — see the type scale in styles/themes/civic/system.css.
import '../styles/global.css';
import '@fontsource/zilla-slab/latin-500.css';
import '@fontsource/zilla-slab/latin-600.css';
import '@fontsource/zilla-slab/latin-700.css';
import '@fontsource-variable/source-sans-3';
import '../styles/themes/civic/system.css';
import '../styles/themes/civic/hero.css';
import '../styles/themes/civic/modules.css';
import '../styles/themes/civic/engagement.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  /** Error/utility pages: skip canonical + og:url and mark noindex. */
  noindex?: boolean;
}
const { title, description = site.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <!-- matches --color-navy in styles/themes/civic/system.css -->
    <meta name="theme-color" content="#1f2a44" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link sr-only focus:not-sr-only">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
