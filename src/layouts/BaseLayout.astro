---
// Shared document shell. Theme-agnostic: it imports NO CSS and NO fonts —
// each of the three theme layout wrappers (Gothic/Civic/CapitolLayout.astro)
// owns those, so only the active direction's stylesheet and its two font
// families ship on any given route.
import ThemePreviewBar from '../components/ThemePreviewBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';
import { themes, DEFAULT_THEME, type ThemeId } from '../data/themes';

export interface Props {
  title?: string;
  description?: string;
  /** Error/utility pages: skip canonical + og:url and mark noindex. */
  noindex?: boolean;
  theme?: ThemeId;
}
const {
  title,
  description = site.description,
  noindex = false,
  theme = DEFAULT_THEME,
} = Astro.props;

const def = themes[theme];
// Preview routes are always noindex. They carry NO canonical: `noindex` plus a
// canonical pointing at `/` is contradictory, and search engines may propagate
// the noindex to the canonical target — i.e. deindex the real homepage.
const robotsNoindex = noindex || def.preview;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      robotsNoindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={def.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!robotsNoindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link sr-only focus:not-sr-only">Skip to content</a>
    <ThemePreviewBar current={theme} />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
