---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { site } from '../data/site';

// ─────────────────────────────────────────────────────────────────────────
// One glyph per card, drawn as solid masses and converted to ENGRAVED
// contours by the ink-role classes in engagement.css — the same .g-fill /
// .g-line / .g-line-fill / .g-flame / .g-spark contract the value glyphs use,
// translated to the dark plate. One icon language for the whole sheet.
//
// Volunteer is an hourglass rather than the obvious hand: the card's own copy
// is about the hour, and an hourglass engraves cleanly at 32px where a hand
// does not. Decorative → the wrapper carries aria-hidden.
// ─────────────────────────────────────────────────────────────────────────
const icons = [
  // Volunteer — an hourglass. "Every hour moves us forward."
  `<path class="g-fill" d="M16 7 H32 L24 24 L32 41 H16 L24 24 Z"/>
   <path class="g-line" d="M14 6 H34 M14 42 H34" stroke-width="2"/>
   <path class="g-flame" d="M24 25 L29 39 H19 Z"/>
   <circle class="g-spark" cx="24" cy="20" r="1.5"/>`,
  // Attend a Meeting — a calendar with the date struck
  `<path class="g-fill" d="M8 12 H40 V41 H8 Z"/>
   <path class="g-line" d="M8 21 H40"/>
   <path class="g-line" d="M16 7 V15 M32 7 V15" stroke-width="2"/>
   <path class="g-flame" d="M24 24 L25.65 28.73 L30.66 28.84 L26.66 31.87 L28.11 36.66 L24 33.8 L19.89 36.66 L21.34 31.87 L17.34 28.84 L22.35 28.73 Z"/>`,
  // Spread the Word — a megaphone, bell to the right
  `<path class="g-fill" d="M9 19 L29 9 V39 L9 29 Z"/>
   <path class="g-line" d="M13 28.5 L16 41 H21 L18.6 30.3"/>
   <path class="g-flame" d="M34 16 A10 10 0 0 1 34 32"/>
   <path class="g-line-fill" d="M39 11 A16 16 0 0 1 39 37"/>`,
];
---

<section id="get-involved" class="involve" aria-labelledby="get-involved-title">
  <div class="section-inner">
    <SectionHeading
      tone="ink"
      eyebrow="Join Us"
      title="Get Involved"
      headingId="get-involved-title"
    />

    <p class="section-lead">
      There’s a place for every neighbor here. Whether you have an hour or an evening,
      your time and voice help build a stronger Staunton.
    </p>

    <div class="involve-grid">
      {
        site.getInvolved.map((item, i) => (
          <div class="involve-card">
            <span class="involve-ico" aria-hidden="true">
              <svg
                class="involve-glyph"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 48 48"
                fill="none"
                set:html={icons[i]}
              />
            </span>
            <h3 class="involve-card-title">{item.title}</h3>
            <p class="involve-body">{item.body}</p>
            <div class="involve-cta">
              <Button href={item.cta.href} variant="accent" size="sm">
                {item.cta.label}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
