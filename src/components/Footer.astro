---
// THE COLOPHON — the foot of the sheet. The struck seal's second and last
// appearance, three columns of particulars, then the imprint and the legal
// line. Meeting details live in The Committee now, so this stays at three.
import { site } from '../data/site';
import Seal from './Seal.astro';
import SocialIcon from './SocialIcon.astro';
import Star from './Star.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- names the landmark and gives the column heads an ancestor -->
  <h2 class="sr-only">Committee information</h2>

  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-lockup">
        <Seal size={42} decorative />
        <span class="footer-wordmark">{site.name}</span>
      </div>
      <p class="footer-tagline">{site.tagline}</p>
      {
        site.socials.length > 0 && (
          <div class="footer-socials">
            {site.socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="footer-social"
              >
                <SocialIcon icon={s.icon} size={18} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div>
      <h3 class="footer-col-head">Explore</h3>
      <ul class="footer-list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.primaryCta.href} class="footer-link">
            {site.primaryCta.label}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="footer-col-head">Contact</h3>
      <ul class="footer-list">
        <li>
          <a href={`mailto:${site.contact.email}`} class="footer-link">
            {site.contact.email}
          </a>
        </li>
        <li><span class="footer-link">{site.contact.phone}</span></li>
        <li><span class="footer-link">{site.contact.mailing}</span></li>
      </ul>
    </div>
  </div>

  <div class="footer-legal">
    <div class="footer-legal-inner">
      <!-- the imprint: the line at the foot of a broadside naming who had it
           printed. The sheet's last star, and its only one down here. -->
      <p class="footer-imprint">
        <Star size={10} class="footer-star" />
        {site.imprint}
      </p>
      <p class="footer-legal-text">
        {site.disclaimer} © {year} {site.name}.
      </p>
    </div>
  </div>
</footer>
