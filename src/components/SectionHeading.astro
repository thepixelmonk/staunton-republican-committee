---
import Star from './Star.astro';

interface Props {
  title: string;
  eyebrow?: string;
  align?: 'center' | 'left';
  class?: string;
}
const { title, eyebrow, align = 'center', class: className = '' } = Astro.props;
const isCenter = align === 'center';
---

<div class={`section-heading ${isCenter ? 'text-center' : 'text-left'} ${className}`}>
  {
    eyebrow && (
      <p class="section-eyebrow">
        {eyebrow}
      </p>
    )
  }
  <h2 class="section-title">{title}</h2>
  <div class={`section-rule mt-5 flex items-center gap-3 ${isCenter ? 'justify-center' : 'justify-start'}`}>
    <span class="section-rule-tick h-px w-10"></span>
    <Star size={14} class="section-rule-star" />
    <span class="section-rule-tick h-px w-10"></span>
  </div>
</div>
