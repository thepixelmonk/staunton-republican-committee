---
// The sheet's section head. Three ingredients — a brick eyebrow, a display
// title, a gold hairline — arranged two ways so the page has a hierarchy
// instead of the same stack printed five times. See system.css.
//
//   plate    centred, diamonds flanking the eyebrow. Prose sections.
//   running  ranged left, a gold rule running out to the right margin.
//            The list sections, and only those.
interface Props {
  title: string;
  eyebrow?: string;
  variant?: 'plate' | 'running';
  /** `ink` recolours the head for the navy plate. */
  tone?: 'paper' | 'ink';
  /** Set so the enclosing <section> can point aria-labelledby at the title. */
  headingId?: string;
  class?: string;
}
const {
  title,
  eyebrow,
  variant = 'plate',
  tone = 'paper',
  headingId,
  class: className = '',
} = Astro.props;

const classes = [
  'section-heading',
  `section-heading--${variant}`,
  tone === 'ink' && 'section-heading--ink',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  {
    eyebrow && (
      <p class="section-eyebrow">
        <span class="section-diamond" aria-hidden="true" />
        <span>{eyebrow}</span>
        <span class="section-diamond" aria-hidden="true" />
      </p>
    )
  }
  {
    variant === 'running' ? (
      <div class="section-titlebar">
        <h2 class="section-title" id={headingId}>
          {title}
        </h2>
        <span class="section-runner" aria-hidden="true" />
      </div>
    ) : (
      <h2 class="section-title" id={headingId}>
        {title}
      </h2>
    )
  }
</div>
