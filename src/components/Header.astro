---
// The masthead is SET TYPE, not a device. A broadside puts its name in metal
// with a rule under it; the struck seal appears twice on the page and twice
// only — the hero, and its echo in the colophon.
import { site, url } from '../data/site';
import Button from './Button.astro';
import MobileNav from './MobileNav.svelte';
---

<header class="site-header">
  <!-- the printer's top rule -->
  <span class="flag-stripe" aria-hidden="true"></span>

  <div class="site-header__bar">
    <a href={url()} class="masthead-lockup" aria-label={`${site.name} — home`}>
      <span class="masthead-name">{site.name}</span>
      <span class="masthead-city">{site.city}</span>
    </a>

    <nav class="masthead-nav" aria-label="Primary">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <Button href={site.primaryCta.href} size="sm">{site.primaryCta.label}</Button>
    </nav>

    <div class="masthead-mobile">
      <!-- client:media, not client:load: the toggle is display:none above
           768px, so desktop should never pay for the Svelte runtime. Keep the
           query in step with the breakpoint in system.css. -->
      <MobileNav client:media="(max-width: 767px)" navItems={site.nav} cta={site.primaryCta} />
    </div>
  </div>
</header>
