---
// Dispatches to the direction's hero. The three are statically imported, which
// is free: .astro components emit no client JS, and none of them carries a
// <style> block — a scoped style here would ship on every route, including `/`.
import HeroGothic from './HeroGothic.astro';
import HeroCivic from './HeroCivic.astro';
import HeroCapitol from './HeroCapitol.astro';
import type { ThemeId } from '../data/themes';

interface Props {
  theme: ThemeId;
}
const { theme } = Astro.props;

const HEROES = { gothic: HeroGothic, civic: HeroCivic, capitol: HeroCapitol } as const;
const HeroImpl = HEROES[theme];
---

<HeroImpl />
