---
import SectionHeading from './SectionHeading.astro';
import { events } from '../data/events';
import { site } from '../data/site';

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const MONTHS_FULL = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

/** Splits the ISO string rather than constructing a Date — no timezone drift. */
function fmtDate(iso: string) {
  const [y, m, d] = iso.split('-').map(Number);
  return {
    mon: MONTHS[m - 1],
    day: String(d).padStart(2, '0'),
    full: `${MONTHS_FULL[m - 1]} ${d}, ${y}`,
  };
}

// Only future dates render, so a stale data file quietly falls back to the
// empty state instead of advertising a day that has already gone by. The
// comparison is a plain ISO string compare against the build date (UTC), which
// keeps an event listed through the whole of its own day.
const today = new Date().toISOString().slice(0, 10);
const upcoming = events
  .filter((event) => event.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
---

<section
  id="events"
  class="events section sheet-deep sheet-deep--foot"
  aria-labelledby="events-title"
>
  <div class="section-inner section-inner--measure">
    <SectionHeading eyebrow="Mark Your Calendar" title="Upcoming Events" headingId="events-title" />

    {
      upcoming.length === 0 ? (
        <p class="events-empty">
          Nothing on the calendar just yet. The committee meets on the second Tuesday of
          every month — <a href="#contact">write to us</a> and we’ll send you the next date.
        </p>
      ) : (
        <ul class="event-list">
          {upcoming.map((event) => {
            const { mon, day, full } = fmtDate(event.date);
            return (
              <li class="event-card">
                {/* the visible plate is decorative; the full date is what gets announced */}
                <time class="event-date" datetime={event.date}>
                  <span class="event-date-mon" aria-hidden="true">
                    {mon}
                  </span>
                  <span class="event-date-day" aria-hidden="true">
                    {day}
                  </span>
                  <span class="sr-only">{full}</span>
                </time>
                <div class="event-body-wrap">
                  <h3 class="event-title">{event.title}</h3>
                  <p class="event-meta">
                    {event.time} &middot; {event.location}
                  </p>
                  <p class="event-body">{event.description}</p>
                  {event.href && (
                    <a href={event.href} class="event-link">
                      Details
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>
