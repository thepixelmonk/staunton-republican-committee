---
// PREVIEW-ONLY — delete when a direction is chosen (see AGENTS.md).
//
// A plain link nav: no JS, no localStorage, no pre-paint script, so there is
// no flash of the wrong theme. Each link is a real navigation to that
// direction's route, which is why the active one is marked aria-current="page"
// and NOT aria-pressed — these are links, not toggle buttons, and role="link"
// does not support aria-pressed.
import { themeList, type ThemeId } from '../data/themes';

interface Props {
  current: ThemeId;
}
const { current } = Astro.props;
---

<div class="tpb" data-preview-bar>
  <nav class="tpb-inner" aria-label="Design direction preview">
    <span class="tpb-caption">Preview a design direction</span>
    <ul class="tpb-list">
      {
        themeList.map((t) => (
          <li>
            <a
              class="tpb-link"
              href={t.href}
              aria-current={t.id === current ? 'page' : undefined}
            >
              <span class="tpb-name">{t.label}</span>
              <span class="tpb-blurb">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* Deliberately token-free and utility-free.
     This control must look IDENTICAL on all three routes, so it inherits
     nothing from the active theme. Tailwind utilities like `bg-cream` resolve
     through var(--color-*), which each theme re-points — the bar would
     silently adopt every palette and stop being a neutral comparison control.
     Every INHERITED property is re-declared too, because each theme sets
     font-family / line-height / letter-spacing / color on `body`. */
  .tpb {
    background: #eceae5;
    border-bottom: 1px solid #cfcbc3;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: #2b2b2b;
    line-height: 1.4;
    letter-spacing: normal;
  }
  .tpb-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .tpb-caption {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b6b;
  }
  .tpb-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tpb-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    border: 1px solid #b9b4ab;
    border-radius: 3px;
    background: #fbfaf8;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    text-decoration: none;
    color: #2b2b2b;
  }
  .tpb-link:hover {
    border-color: #6b6b6b;
    background: #ffffff;
  }
  .tpb-link[aria-current='page'] {
    background: #2b2b2b;
    border-color: #2b2b2b;
    color: #fbfaf8;
  }
  .tpb-link:focus-visible {
    outline: 2px solid #2b2b2b;
    outline-offset: 2px;
  }
  .tpb-blurb {
    font-weight: 400;
    font-size: 0.6875rem;
    color: #6b6b6b;
  }
  .tpb-link[aria-current='page'] .tpb-blurb {
    color: #cfcbc3;
  }

  @media (max-width: 640px) {
    .tpb-blurb { display: none; }
    .tpb-caption { width: 100%; }
  }
  @media print {
    .tpb { display: none; }
  }
</style>
