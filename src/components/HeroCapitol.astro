---
// PREVIEW-ONLY — delete when a direction is chosen (see AGENTS.md).
//
// Capitol Cream's hero: a LEFT-ANCHORED EDITORIAL MASTHEAD in whitespace.
// No illustration, no frame, nothing centred.
//
// The .hero-masthead wrapper is load-bearing: it starts the `cc-folio` CSS
// counter at 01, which then runs 02–05 through the shared section headings and
// turns the page into a numbered document. Removing it renumbers the whole site.
import Button from './Button.astro';
import Seal from './Seal.astro';
import { site } from '../data/site';
---

<section id="hero" class="hero">
  <div class="hero-inner">
    <header class="hero-masthead">
      <p class="hero-eyebrow">
        {site.city}<span class="hero-eyebrow-tick" aria-hidden="true"></span>
      </p>

      <h1 class="hero-title">Staunton<br />Republican<br />Committee</h1>

      <p class="hero-tagline">{site.tagline}</p>

      <div class="hero-actions">
        <Button href={site.primaryCta.href} variant="solid" size="md">
          {site.primaryCta.label}
        </Button>
        <Button href="#events" variant="ghost" size="md">Upcoming Events</Button>
      </div>
    </header>

    <aside class="hero-colophon">
      <span class="hero-colophon-seal" aria-hidden="true"><Seal size={62} decorative /></span>
      <dl class="hero-facts">
        <div class="hero-fact">
          <dt>Seat</dt>
          <dd>{site.city}</dd>
        </div>
        <div class="hero-fact">
          <dt>Meets</dt>
          <dd>{site.meeting.when}</dd>
        </div>
        <div class="hero-fact">
          <dt>Correspondence</dt>
          <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
