---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Star from '../components/Star.astro';
import { url } from '../data/site';
---

<BaseLayout title="Page Not Found" noindex>
  <section class="notfound section" aria-labelledby="notfound-title">
    <div class="section-inner section-inner--measure">
      <p class="notfound-eyebrow">
        <span class="section-diamond" aria-hidden="true"></span>
        <span>Not on the sheet</span>
        <span class="section-diamond" aria-hidden="true"></span>
      </p>
      <p class="notfound-number" aria-hidden="true">404</p>
      <h1 class="notfound-title" id="notfound-title">This page has wandered off</h1>
      <p class="notfound-body">
        The page you’re looking for doesn’t exist, or it may have moved. Let’s get you
        back home.
      </p>
      <div class="notfound-actions">
        <Button href={url()} variant="solid" size="md">Return home</Button>
      </div>
      <span class="notfound-star" aria-hidden="true"><Star size={13} /></span>
    </div>
  </section>
</BaseLayout>
